# my-PV AC ELWA Prometheus Exporter Configuration
# Copy this file and customize it for your setup

# Device Configuration
# Comma-separated URLs for multiple devices
MYPVELWAEXPORTER_SERVE_URL=http://192.168.1.125
# Alternative with multiple devices:
# MYPVELWAEXPORTER_SERVE_URL=http://192.168.2.125,http://192.168.3.126

# Server Configuration (for serve command)
MYPVELWAEXPORTER_SERVE_PORT=8000
MYPVELWAEXPORTER_SERVE_LOG_LEVEL=INFO

# Export Configuration (for export command)
# Same URL as serve, but for one-time export
MYPVELWAEXPORTER_EXPORT_URL=http://192.168.1.125
MYPVELWAEXPORTER_EXPORT_LOG_LEVEL=INFO
# Uncomment to save metrics to file instead of stdout
# MYPVELWAEXPORTER_EXPORT_OUTPUT=/path/to/metrics.txt

# Logging Configuration (optional for both commands)
# MYPVELWAEXPORTER_SERVE_LOG_FILE=/path/to/serve.log
# MYPVELWAEXPORTER_EXPORT_LOG_FILE=/path/to/export.log
